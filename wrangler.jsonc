{
  // Cloudflare Worker, joka palvelee kaikkia toimipisteiden lounassivuja (sites.json)
  "name": "ruokis",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Worker ajetaan sivupyynnöille; kuvat, data ja asetukset tarjoillaan suoraan
    "run_worker_first": ["/*", "!/assets/*", "!/data/*", "!/sites.json"]
  }
}
